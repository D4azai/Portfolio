# Server only. Copy to .env.local (ignored); never put these in public JS.
SITE_ORIGIN=https://aynko.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Both values must match the single confirmed Supabase Auth user.
ADMIN_EMAIL=aymane.chellak@outlook.fr
ADMIN_USER_ID=
# Independent random secrets, at least 32 characters each.
SESSION_SECRET=
RATE_LIMIT_SECRET=
ANALYTICS_SEC RET=
ANALYTICS_ENABLED=false
# Vercel sets VERCEL_ENV. Analytics additionally requires production.
# Optional owner notification; only a generic notice, never the message content.
RESEND_API_KEY=
NOTIFICATION_FROM=

# Optional conversational robot. Server only; never expose this in the React bundle.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
# For local development set SITE_ORIGIN=http://127.0.0.1:4173 above.
